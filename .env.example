# Copy to .env; generate a private random development token (see README).
FINTRACK_DEV_API_KEY=
# Exact Neon Auth endpoint used by the frontend. Public endpoint, no secret.
FINTRACK_NEON_AUTH_URL=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth
# Server-only random secret (at least 32 characters) for command fingerprints. Never EXPO_PUBLIC_*.
FINTRACK_COMMAND_FINGERPRINT_KEY=
# Keep false for the user application; old unscoped scaffold routes are disabled by default.
FINTRACK_ENABLE_DEVELOPMENT_ROUTES=false
# Neon pooled runtime URL, SSL required. Keep credentials out of frontend config.
FINTRACK_DATABASE_URL=
# Optional: restricted read-only connection to the Auth branch when finance uses another branch.
# Must contain neon_auth.session for FINTRACK_NEON_AUTH_URL; otherwise leave empty.
FINTRACK_AUTH_DATABASE_URL=
# Neon direct (non-pooler) URL for explicit Alembic migrations.
FINTRACK_MIGRATION_DATABASE_URL=
FINTRACK_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8081"]
